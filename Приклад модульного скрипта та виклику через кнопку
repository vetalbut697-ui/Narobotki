-- StarterGui -> ScreenGui -> ChangeCameraButton -> LocalScript
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local button = script.Parent

-- Підключаємо наш модуль камери
local CameraController = require(ReplicatedStorage:WaitForChild("CameraController"))

-- Прапорець для перемикання станів
local isTopDown = false

button.MouseButton1Click:Connect(function()
	isTopDown = not isTopDown

	if isTopDown then
		CameraController.SetMode("Back")
		button.Text = "Режим: Згори"
	else
		CameraController.SetMode("Default")
		button.Text = "Режим: Звичайний"
	end
end)
